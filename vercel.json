{
  "functions": {
    "server.js": {
      "includeFiles": "{*.html,*.css,*.js,*.json,*.ico,*.png,*.svg,*.jpg,*.jpeg,*.gif,*.webp,*.avif,*.mp4,*.woff,*.woff2,*.ttf,images/**,assets/**,fonts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/checkout-complete",
      "destination": "/api/commerce/checkout-complete"
    },
    {
      "source": "/api/checkout-start",
      "destination": "/api/commerce/checkout-start"
    },
    {
      "source": "/api/confirm-business-upgrade",
      "destination": "/api/commerce/confirm-business-upgrade"
    },
    {
      "source": "/api/create-payment-intent",
      "destination": "/api/commerce/create-payment-intent"
    },
    {
      "source": "/api/payment-config",
      "destination": "/api/commerce/payment-config"
    },
    {
      "source": "/api/project-template-workspace",
      "destination": "/api/commerce/project-template-workspace"
    },
    {
      "source": "/api/project-template-workspace-complete",
      "destination": "/api/commerce/project-template-workspace-complete"
    },
    {
      "source": "/api/project-template-download",
      "destination": "/api/commerce/project-template-download"
    },
    {
      "source": "/api/project-template-workspace-save",
      "destination": "/api/commerce/project-template-workspace-save"
    },
    {
      "source": "/api/project-template-workspace-unlock",
      "destination": "/api/commerce/project-template-workspace-unlock"
    },
    {
      "source": "/api/project-sync",
      "destination": "/api/commerce/project-sync"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/commerce/stripe-webhook"
    },
    {
      "source": "/api/template-access-complete",
      "destination": "/api/commerce/template-access-complete"
    },
    {
      "source": "/api/template-access-start",
      "destination": "/api/commerce/template-access-start"
    },
    {
      "source": "/api/template-download",
      "destination": "/api/commerce/template-download"
    },
    {
      "source": "/api/polar-webhook",
      "destination": "/api/webhooks/polar"
    }
  ]
}
