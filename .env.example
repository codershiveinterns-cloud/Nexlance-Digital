# Coda / Codashop Distribution fulfillment is optional and is not a hosted checkout provider.
# Do not configure Coda as a Stripe-like checkout gateway. Use the official Validate/Topup APIs only.
# CODA_SANDBOX_API_KEY=test_your_coda_sandbox_api_key
# CODA_PRODUCTION_API_KEY=live_your_coda_production_api_key
# CODA_API_KEY=$CODA_PRODUCTION_API_KEY
# CODA_PROJECT_ID=your_coda_project_id
# CODA_DEFAULT_COUNTRY=India
# CODA_SECRET_KEY=replace_with_coda_secret_key
# CODA_SIGNATURE_SCHEME=header-hmac-sha256
# CODA_VALIDATE_API_URL=https://4s67vyhfj9.execute-api.ap-southeast-1.amazonaws.com/staging/validate/V2
# CODA_TOPUP_API_URL=https://4s67vyhfj9.execute-api.ap-southeast-1.amazonaws.com/staging/topup/V2
# CODA_SERVER_LIST_API=mock-serverlist-api
# Legacy aliases still supported by the backend:
# CODA_VALIDATION_URL=$CODA_VALIDATE_API_URL
# CODA_TOPUP_URL=$CODA_TOPUP_API_URL
# CODA_SERVER_LIST_URL=$CODA_SERVER_LIST_API
# CODA_SHARED_SECRET=$CODA_SECRET_KEY
# Official product mapping:
# NXL-TEMPLATE-001 -> single_template
# NXL-PLUS-M-001 -> plus_monthly
# NXL-PLUS-Y-001 -> plus_yearly
# NXL-PRO-M-001 -> pro_monthly
# NXL-PRO-Y-001 -> pro_yearly
# NXL-BUS-M-001 -> business_monthly
# NXL-BUS-Y-001 -> business_yearly

